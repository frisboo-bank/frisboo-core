{
    "properties": [
        {
            "name": "frisboo.corebanking.publisher.kafka.enabled",
            "type": "java.lang.Boolean",
            "description": "Enable Kafka feature",
            "defaultValue": false
        },
        {
            "name": "frisboo.corebanking.publisher.kafka.bootstrap-servers",
            "type": "java.lang.String",
            "description": "Kafka bootstrap servers",
            "defaultValue": "localhost:9092"
        },
        {
            "name": "frisboo.corebanking.publisher.kafka.topics",
            "type": "java.util.List<java.lang.String>",
            "description": "List of Kafka topics to publish to",
            "defaultValue": [
                "corebanking-events"
            ]
        }
    ]
}
